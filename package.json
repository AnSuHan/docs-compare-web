{
  "name": "docdiff",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node server/static.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "inspect": "vite-node scripts/inspect.ts --",
    "lint:no-upload": "node scripts/check-no-upload.mjs",
    "verify": "npm run lint:no-upload && npm run test && npm run build && npm run lint:bundle",
    "lint:bundle": "node scripts/check-bundle.mjs",
    "deploy:plan": "node scripts/deploy-plan.mjs",
    "deploy:record": "node scripts/deploy-plan.mjs --record"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-virtual": "^3.13.0",
    "@types/node": "^26.4.1",
    "@types/pako": "^2.0.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "cfb": "^1.2.2",
    "comlink": "^4.4.2",
    "jszip": "^3.10.1",
    "pako": "^2.1.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "vitest": "^3.0.5"
  }
}
